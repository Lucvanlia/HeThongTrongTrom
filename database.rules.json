{
  "rules": {
    "security": {
      ".read": "auth != null",
      "control": {
        ".write": "auth != null",
        "armed": { ".validate": "newData.isBoolean()" },
        "doorLocked": { ".validate": "newData.isBoolean()" },
        "silenceAlarm": { ".validate": "newData.isBoolean()" },
        "cmdId": { ".validate": "newData.isNumber()" },
        "lastUpdated": { ".validate": "newData.isNumber()" }
      },
      "config": {
        ".write": "auth != null",
        "thresholdCm": {
          ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 100"
        },
        "telemetryIntervalMs": {
          ".validate": "newData.isNumber() && newData.val() >= 500 && newData.val() <= 60000"
        },
        "lastUpdated": { ".validate": "newData.isNumber()" }
      },
      "schedule": {
        ".write": "auth != null",
        "enabled": { ".validate": "newData.isBoolean()" },
        "armTime": { ".validate": "newData.isString()" },
        "disarmTime": { ".validate": "newData.isString()" },
        "lastUpdated": { ".validate": "newData.isNumber()" }
      },
      "auditLogs": {
        ".write": "auth != null",
        ".indexOn": ["timestamp"]
      },
      "alerts": {
        ".indexOn": ["timestamp"]
      }
    },
    "stats": {
      "daily": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": [".key"]
      }
    }
  }
}
