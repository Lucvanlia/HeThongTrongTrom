# ==============================================================================
# Web Dashboard Environment Configuration (React 19 + TypeScript + Vite)
# HƯỚNG DẪN: Sao chép file này thành .env hoặc .env.local và điền thông tin thật.
# File .env và .env.local đã được chặn bởi .gitignore, an toàn không bị lộ lên Git.
# ==============================================================================

# Firebase Realtime Database (Hot Path - Dữ liệu thời gian thực <50ms)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your-database-id.asia-southeast1.firebasedatabase.app"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Azure Backend API (Tùy chọn khi gọi Azure Functions / Static Web Apps)
# VITE_AZURE_API_BASE_URL="https://your-app.azurestaticapps.net"

