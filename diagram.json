{
  "version": 1,
  "author": "Lucvanlia",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir1",
      "top": -140,
      "left": -260,
      "attrs": {}
    },
    {
      "type": "wokwi-hc-sr04",
      "id": "sonar1",
      "top": -140,
      "left": 180,
      "attrs": { "distance": "80" }
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd1",
      "top": -260,
      "left": -50,
      "attrs": { "pins": "i2c" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay1",
      "top": 200,
      "left": -90,
      "attrs": {}
    },
    {
      "type": "wokwi-servo",
      "id": "servo1",
      "top": 360,
      "left": -70,
      "attrs": { "hornColor": "blue" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": 200,
      "left": -260,
      "attrs": { "volume": "0.1" }
    },
    {
      "type": "wokwi-led",
      "id": "led_alarm",
      "top": 180,
      "left": 160,
      "attrs": { "color": "yellow", "label": "Alarm LED" }
    },
    {
      "type": "wokwi-led",
      "id": "led_armed",
      "top": 250,
      "left": 160,
      "attrs": { "color": "green", "label": "ARM LED" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_alarm",
      "top": 190,
      "left": 90,
      "attrs": { "resistance": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_armed",
      "top": 260,
      "left": 90,
      "attrs": { "resistance": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_div1",
      "top": -40,
      "left": 260,
      "attrs": { "resistance": "1000" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_div2",
      "top": 10,
      "left": 260,
      "attrs": { "resistance": "2000" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:5V", "pir1:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "pir1:GND", "black", [ "v0" ] ],
    [ "esp:13", "pir1:OUT", "gold", [ "v0" ] ],

    [ "esp:5V", "sonar1:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "sonar1:GND", "black", [ "v0" ] ],
    [ "esp:5", "sonar1:TRIG", "blue", [ "v0" ] ],
    [ "sonar1:ECHO", "r_div1:1", "purple", [ "v0" ] ],
    [ "r_div1:2", "esp:18", "purple", [ "v0" ] ],
    [ "r_div1:2", "r_div2:1", "purple", [ "v0" ] ],
    [ "r_div2:2", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:5V", "lcd1:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "lcd1:GND", "black", [ "v0" ] ],
    [ "esp:21", "lcd1:SDA", "green", [ "v0" ] ],
    [ "esp:22", "lcd1:SCL", "blue", [ "v0" ] ],

    [ "esp:5V", "relay1:VCC", "red", [ "v0" ] ],
    [ "esp:GND.2", "relay1:GND", "black", [ "v0" ] ],
    [ "esp:25", "relay1:IN", "purple", [ "v0" ] ],
    [ "esp:5V", "relay1:COM", "red", [ "v0" ] ],
    [ "relay1:NO", "servo1:V+", "red", [ "v0" ] ],
    [ "esp:GND.2", "servo1:GND", "black", [ "v0" ] ],
    [ "esp:19", "servo1:PWM", "orange", [ "v0" ] ],

    [ "esp:23", "bz1:2", "orange", [ "v0" ] ],
    [ "esp:GND.2", "bz1:1", "black", [ "v0" ] ],

    [ "esp:2", "r_alarm:1", "yellow", [ "v0" ] ],
    [ "r_alarm:2", "led_alarm:A", "yellow", [ "v0" ] ],
    [ "led_alarm:C", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:4", "r_armed:1", "green", [ "v0" ] ],
    [ "r_armed:2", "led_armed:A", "green", [ "v0" ] ],
    [ "led_armed:C", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
