# ==============================================================================
# BẢN MẪU MÔI TRƯỜNG DỰ ÁN HỆ THỐNG CHỐNG TRỘM IOT (.env.example)
# Hệ thống kết hợp ESP32 Dual-Core + Firebase Realtime + Microsoft Azure Cloud
# ==============================================================================
# HƯỚNG DẪN: 
# 1. Sao chép file này thành ".env" tại thư mục gốc để lưu trữ cấu hình môi trường.
# 2. File ".env" và "*.env.local" ĐÃ ĐƯỢC .gitignore BẢO VỆ TUYỆT ĐỐI KHÔNG LỘ RA NGOÀI.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH PHẦN CỨNG FIRMWARE ESP32 (Tương ứng include/secrets.h)
# ------------------------------------------------------------------------------
WIFI_SSID="YOUR_WIFI_SSID"
WIFI_PASS="YOUR_WIFI_PASSWORD"

# Firebase Realtime Database trên ESP32 (Hot Path <50ms)
ESP32_FIREBASE_HOST="your-database-id.asia-southeast1.firebasedatabase.app"
ESP32_FIREBASE_AUTH="YOUR_FIREBASE_DATABASE_SECRET_KEY"

# Azure IoT Hub (Cold Path - Quản trị thiết bị, C2D Direct Method)
ESP32_IOTHUB_HOST="your-iothub-name.azure-devices.net"
ESP32_DEVICE_ID="esp32-chongtrom-01"
ESP32_DEVICE_KEY="YOUR_BASE64_PRIMARY_DEVICE_KEY"

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH WEB DASHBOARD (Tương ứng web/.env)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your-database-id.asia-southeast1.firebasedatabase.app"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH CLOUD AZURE FUNCTIONS & LOGIC APPS (Tương ứng local.settings.json)
# ------------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
AZURE_WEB_PUBSUB_CONNECTION_STRING="Endpoint=https://....webpubsub.azure.com;AccessKey=...;Version=1.0;"
AZURE_LOGIC_APPS_ALARM_WEBHOOK_URL="https://prod-xx.southeastasia.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?..."
AZURE_LOGIC_APPS_OFFLINE_WEBHOOK_URL="https://prod-xx.southeastasia.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?..."

