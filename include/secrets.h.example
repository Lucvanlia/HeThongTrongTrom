#pragma once

// Template file mẫu - Hãy sao chép file này thành "secrets.h" và điền thông tin thực tế của bạn.
// File "secrets.h" đã được chặn bởi .gitignore để bảo vệ an toàn thông tin bí mật.

namespace system_secrets {
    // 1. Wi-Fi Configuration (SSID và Mật khẩu)
    constexpr const char* WIFI_SSID = "YOUR_WIFI_SSID";
    constexpr const char* WIFI_PASS = "YOUR_WIFI_PASSWORD";

    // 2. Firebase Realtime Database Configuration (Hot Path - Cập nhật tức thời <50ms)
    constexpr const char* FIREBASE_HOST = "your-database-id.asia-southeast1.firebasedatabase.app";
    constexpr const char* FIREBASE_AUTH = "YOUR_FIREBASE_DATABASE_SECRET_KEY";

    // 3. Azure IoT Hub Configuration (Cold Path & Quản lý thiết bị)
    constexpr const char* IOTHUB_HOST = "YOUR_IOT_HUB_NAME.azure-devices.net";
    constexpr const char* DEVICE_ID   = "ESP32_SECURITY_HUB";
    
    // SAS Token hoặc Device Primary Symmetric Key (Base64)
    constexpr const char* DEVICE_KEY  = "YOUR_DEVICE_PRIMARY_KEY_HERE";

    // 4. Azure Logic Apps Webhook Cảnh Báo Khẩn Cấp (Gửi email khi đột nhập)
    constexpr const char* AZURE_ALERT_WEBHOOK_URL = "YOUR_LOGIC_APPS_WEBHOOK_URL_HERE";
}
